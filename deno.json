{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env --allow-write=.runtime server.ts",
    "dev": "deno run --allow-net --allow-read --allow-env --allow-write=.runtime --watch server.ts"
  },
  "deploy": {
    "runtime": {
      "type": "dynamic",
      "entrypoint": "./server.ts",
      "cwd": "."
    },
    "org": "symful",
    "app": "present-alin"
  },
  "imports": {
    "@std/http": "jsr:@std/http@1",
    "@std/path": "jsr:@std/path@1"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  },
  "lint": {
    "exclude": [
      "public"
    ]
  },
  "unstable": [
    "kv"
  ]
}
